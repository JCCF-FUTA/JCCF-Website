# ─────────────────────────────────────────────────────────────────────────────
# JCCF FUTA website — environment variables
# Copy to .env.local for development. In production set these in Vercel.
# Every integration is optional: when a key is missing the site falls back to
# the seed content in lib/content/seed.ts and shows bank details instead of Paystack.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, Paystack callback)
NEXT_PUBLIC_SITE_URL=https://jccffuta.org

# Sanity (content + /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Read token — only needed if the dataset is private.
SANITY_API_READ_TOKEN=
# Shared secret set on the Sanity webhook (Settings → API → Webhooks → Secret)
SANITY_REVALIDATE_SECRET=

# Supabase (newsletter, prayer requests, contact messages, payment log, owner login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack
PAYSTACK_SECRET_KEY=

# YouTube Data API v3 (optional — without it the site reads the public channel RSS feed)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCKBys_fv2AYhOVQ81RP0qug

# Cloudflare Turnstile (spam protection on all forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron protection (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
# Instagram strip (optional): a free Behold.so feed id
NEXT_PUBLIC_BEHOLD_FEED_ID=

# Show unconfirmed sample content (marked "Sample") in a production/preview build. Never set on the live site.
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=
